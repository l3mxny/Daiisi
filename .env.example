# Copy this file to .env.local (gitignored) and fill in. Never commit real values or paste them into chat.
# Do not add a NEXT_PUBLIC_ prefix to any of these: they must stay on the server.

# Satellite imagery (Copernicus Data Space)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Simulated / future SMS through Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Voice field notes: speech-to-text, and the model that interprets what was said
DEEPGRAM_API_KEY=
GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-20b, the same model as the recommendation feature.
GROQ_MODEL=
# Optional. Where the temporary notes file lives. Defaults to ./data/notes.json (gitignored).
NOTES_FILE=
